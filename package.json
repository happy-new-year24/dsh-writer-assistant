{
  "name": "dsh-writer-assistant",
  "version": "1.1.0",
  "description": "连接本机阅文作家助手：每日签到、新建草稿、使用最高使用量大纲、浏览阅文写作技巧，并提供本地角色关系图。面板分「创作 / 灵感 / 大纲 / 关系 / 我的」五个标签。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "writer",
    "yuewen",
    "authorwrite",
    "novel",
    "writing",
    "character-graph"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./relations": "./lib/relations.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "license": "MIT",
  "author": "happy-new-year24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happy-new-year24/dsh-writer-assistant.git"
  },
  "homepage": "https://github.com/happy-new-year24/dsh-writer-assistant#readme",
  "bugs": {
    "url": "https://github.com/happy-new-year24/dsh-writer-assistant/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  }
}
