{
  "name": "dsh-writer-assistant",
  "version": "1.0.0",
  "description": "DSH bundle that connects to the local 作家助手 (Yuewen author client): daily check-in, draft creation with the most-used outline template, and writing-technique browsing, in a four-tab 创作/灵感/大纲/我的 panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "writer",
    "yuewen",
    "authorwrite",
    "novel",
    "writing"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "happy-new-year24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happy-new-year24/dsh-writer-assistant.git"
  },
  "homepage": "https://github.com/happy-new-year24/dsh-writer-assistant#readme",
  "bugs": {
    "url": "https://github.com/happy-new-year24/dsh-writer-assistant/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  }
}
